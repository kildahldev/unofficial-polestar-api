          "email": "Email",
          "password": "Password",
          "demo": "Demo mode (fake vehicle, no API connection)"
        }
      },
      "vehicle": {
        "title": "Select your vehicle",
        "description": "Battery, location, climate, and door/lock status are updated in real-time via streaming. The polling interval controls how often other data is fetched: odometer, tyre health, charging settings (target SOC, amp limit, charge timer), charge locations, climate timers, weather, and OTA updates.",
        "data": {
          "vin": "Vehicle",
          "update_interval": "Polling interval (seconds)",
          "registration_plate": "Registration plate (optional)"
        }
      },
      "guest_vin": {
        "title": "Enter VIN manually",
        "description": "No vehicles were found on this account. This is normal for secondary users and guests. Enter the VIN of the vehicle you have access to.\n\nBattery, location, climate, and door/lock status are updated in real-time via streaming. The polling interval controls how often other data is fetched: odometer, tyre health, charging settings, charge locations, climate timers, weather, and OTA updates.",
