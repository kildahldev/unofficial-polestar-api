          "vin": "VIN (Vehicle Identification Number)",
          "update_interval": "Polling interval (seconds)",
          "registration_plate": "Registration plate (optional)"
        }
      },
      "demo_vin": {
        "title": "Demo vehicle VIN",
        "data": {
          "vin": "VIN (Vehicle Identification Number)"
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate with Polestar",
        "description": "Your session has expired. Please enter your password to reconnect.",
        "data": {
          "password": "Password"
        }
      },
      "reconfigure": {
        "title": "Change the Polestar account",
        "description": "Sign in with the account that has access to {vin}. For example, switch from the main account to a guest account. The vehicle, its entities and their history are kept.",
